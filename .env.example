# Site
SITE_URL=http://localhost:3000

# Product analytics (optional; PostHog captures anonymous pageviews and explicit events only).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Search engine verification (optional meta tags).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# There are no AI, auth, database or payment secrets. AI features run in the learner's browser
# on their own API key, which never reaches the server (see /ai and lib/store/ai-key-store.ts).
